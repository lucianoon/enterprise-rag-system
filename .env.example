LOG_LEVEL=INFO

# Retrieval backends
# RAG_RETRIEVAL_MODE: hybrid (default) | lexical | vector | bm25 | rrf
# bm25/rrf skip the legacy title reranker; rrf remains experimental.
RAG_RETRIEVAL_MODE=hybrid
# RAG_EMBEDDING_BACKEND: hashing (default, offline) | tfidf | sentence-transformer | auto
RAG_EMBEDDING_BACKEND=hashing
# RAG_VECTOR_STORE: memory (default) | qdrant
RAG_VECTOR_STORE=memory
QDRANT_URL=http://localhost:6333
COLLECTION_NAME=enterprise_docs

# Answer generation
# RAG_LLM_MODE: auto (LLM when configured, else deterministic) | llm | deterministic
RAG_LLM_MODE=auto
# Explicit backend wins; in auto, a base URL selects the OpenAI-compatible backend.
RAG_LLM_BACKEND=auto
# RAG_LLM_BASE_URL=https://openrouter.ai/api/v1
# RAG_LLM_API_KEY=
RAG_LLM_MODEL=claude-opus-4-8
ANTHROPIC_API_KEY=

# Answer faithfulness judge
# RAG_JUDGE_MODE: heuristic (default, offline) | llm (Claude as judge) | auto
RAG_JUDGE_MODE=heuristic
RAG_JUDGE_MODEL=claude-opus-4-8

# API auth: when set, /query and /evaluate* require the X-API-Key header.
RAG_API_KEY=

# Batch evaluation dataset (defaults to data/eval/retrieval_v1.jsonl)
# RAG_EVAL_DATASET=
